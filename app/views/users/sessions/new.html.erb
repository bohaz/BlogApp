<div class="flex flex-col  p-4 pt-32 bg-slate-400 min-h-screen">
  <div class="bg-white p-4 m-2 rounded-lg flex flex-col shadow-lg shadow-indigo-500/40">
    <h2 class="font-bold">Log in</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: 'login-form' }) do |f| %>
      
        <%= f.email_field :email, autofocus: true, placeholder: "Email" %>

        <%= f.password_field :password, autocomplete: "current-password", placeholder: "Password" %>
    
        <%= f.submit "Log in", class: 'login-btn' %>
      
    <% end %>

    <%= render "users/shared/links" %>
  </div>
</div>