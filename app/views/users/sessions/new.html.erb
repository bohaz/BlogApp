<div class="flex flex-col min-h-screen">
  <div class="flex flex-col items-center">
    <%= image_tag "welcome.png", alt: "App logo", class: '' %>

  </div>

  <div class="bg-white p-4 rounded-t-3xl flex flex-col">

    <div >
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: 'm-4 flex flex-col gap-2' }) do |f| %>
        
          <%= f.email_field :email, autofocus: true, placeholder: "Email", class: 'border-indigo-500/100 w-full rounded-3xl' %>

          <%= f.password_field :password, autocomplete: "current-password", placeholder: "Password", class: 'border-slate-400 w-full rounded-3xl' %>
      
          <%= f.submit "Log in", class: 'bg-gradient-to-r from-indigo-500 to-indigo-300 hover:bg-indigo-700 text-white p-3 rounded-3xl font-bold' %>
        
      <% end %>
    </div>
    <%= render "users/shared/links" %>
  </div>

</div>