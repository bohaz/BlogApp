<div class="flex flex-col min-h-screen">
  <div class="flex flex-col items-center">
    <%= image_tag "welcome.png", alt: "App logo", class: '' %>
  </div>

  <div class="bg-white p-4 rounded-t-3xl flex flex-col">

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: 'm-4 flex flex-col gap-2' }) do |f| %>
      <%= render "users/shared/error_messages", resource: resource %>

        <%= f.text_field :name, autofocus: true, autocomplete: "name", placeholder: "Full Name", class: 'border-indigo-500/100 w-full rounded-3xl' %>
     
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Email", class: 'border-indigo-500/100 w-full rounded-3xl' %>
    
        <%= f.password_field :password, autocomplete: "new-password", placeholder: "Password", class: 'border-indigo-500/100 w-full rounded-3xl' %>
        <% if @minimum_password_length %>
        <span class="text-center block">(Minimum <%= @minimum_password_length %> characters)</span>
        <% end %>

        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Confirm Password", class: 'border-indigo-500/100 w-full rounded-3xl' %>

        <%= f.submit "Sign up", class: 'bg-gradient-to-r from-indigo-500 to-indigo-300 hover:bg-indigo-700 hover:bg-slate-700 text-white p-3 rounded-3xl font-bold' %>
      
    <% end %>

    <%= render "users/shared/links" %>
  </div>
</div>
