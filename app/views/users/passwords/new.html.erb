<div class="flex flex-col min-h-screen">

  <div class="flex flex-col items-center">
    <%= image_tag "welcome.png", alt: "App logo", class: '' %>
  </div>

  <div class="bg-white p-4 rounded-3xl flex flex-col">

    <h2 class="font-bold ml-4">Forgot your password?</h2>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: 'm-4 flex flex-col gap-2' }) do |f| %>
      <%= render "users/shared/error_messages", resource: resource %>
    
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Email", class: 'border-slate-400 w-full rounded-3xl' %>
 
        <%= f.submit "Send instructions", class: 'bg-gradient-to-r from-indigo-500 to-indigo-300 hover:bg-slate-700 text-white p-3 rounded-3xl font-bold' %>
    
    <% end %>

    <%= render "users/shared/links" %>
  </div>
</div>